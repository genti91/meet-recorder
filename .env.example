# Copiá este archivo a .env y completá los valores. Nunca publiques .env.
MEET_URL=https://meet.google.com/abc-defg-hij
TZ=America/Argentina/Buenos_Aires
SCHEDULE_DAYS=mon,wed
SCHEDULE_TIME=06:34
STOP_TIME=09:30
MAX_MINUTES=180
NO_START_MINUTES=30
ATTENDANCE_DNI=
SCREEN=1280x720
FPS=10
VIDEO_ENCODER=libx264
CHECK_INTERVAL=10
END_CONFIRMATIONS=3
JOIN_TIMEOUT=600

# Avisos opcionales. El tema ntfy debe ser difícil de adivinar.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
